{
  "name": "@canlooks/reactive",
  "version": "5.0.0",
  "description": "Lightweight Proxy reactivity with computed values and synchronous batching",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "node": "./dist/node.js",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/esm/react/index.d.ts",
        "node": "./dist/node-react.js",
        "default": "./dist/esm/react/index.js"
      },
      "require": {
        "types": "./dist/cjs/react/index.d.ts",
        "default": "./dist/cjs/react/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/canlooks/reactive"
  },
  "homepage": "https://github.com/canlooks/reactive",
  "bugs": {
    "url": "https://github.com/canlooks/reactive/issues",
    "email": "canlooks@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "test": "npm run test:node && npm run test:react && npm run typecheck && npm run typecheck:test && npm run typecheck:react",
    "test:node": "tsx --tsconfig tsconfig.test.json test/test.ts",
    "test:react": "tsx --tsconfig tsconfig.react-test.json test/react.tsx",
    "test:dist": "node test/smoke.mjs && node --no-experimental-require-module test/smoke.cjs && npm run typecheck:dist",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "typecheck:dist": "tsc -p test/types/tsconfig.json && tsc -p test/types/react/tsconfig.json",
    "typecheck:react": "tsc -p tsconfig.react-test.json",
    "test:package": "node scripts/test-package.mjs",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@types/react": "^18.3.0 || ^19.0.0",
    "react": "^18.3.1 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "localforage": "^1.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
